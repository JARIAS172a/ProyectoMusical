@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<main class="container mt-5">
    
    <h1 class="text-center mb-4"><i class="fas fa-key"></i> @ViewData["Title"]</h1>

    <div class="row justify-content-center">
        <!-- Formulario de cuenta local -->
        <div class="col-md-6">
            <form id="account" method="post" class="card p-4 shadow mb-4">
                <h2 class="h4 mb-3"><i class="fas fa-lock"></i> Inicia sesión con cuenta local</h2>
                <hr class="mb-4">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email"><i class="fas fa-envelope"></i> Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Contraseña" />
                    <label asp-for="Input.Password"><i class="fas fa-lock"></i> Contraseña</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">
                        <i class="fas fa-square-check"></i> @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="fas fa-rocket"></i> Iniciar sesión
                </button>

                <div class="text-center mt-3">
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">
                            <i class="fas fa-question"></i> ¿Olvidaste tu contraseña?
                        </a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                            <i class="fas fa-pen-to-square"></i> Regístrate como nuevo usuario
                            </a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">
                            <i class="fas fa-square-envelope"></i> Reenviar confirmación de email
                        </a>
                    </p>
                </div>
            </form>
        </div>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
